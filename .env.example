# PostgreSQL
POSTGRES_DB=spider_db
POSTGRES_USER=spider_admin
POSTGRES_PASSWORD=spider_secret_pass
POSTGRES_PORT=5433

# Keycloak DB
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_secret_pass

# Keycloak Admin & Realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=spider-climbing
KEYCLOAK_CLIENT_ID=spider-frontend

# Aplikacja (porty na hoście)
BACKEND_PORT=5001
FRONTEND_PORT=5173

# Powiadomienia (SendGrid API)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=rezerwacje@cw-spider.pl
NOTIFICATIONS_ENABLED=false
